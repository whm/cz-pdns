#!/bin/bash
# Copyright (c) 2026 Bill MacAllister <bill@ca-zephyr.org>
# File: dns-search
# Author: Bill MacAllister
# Description: Perform a wildcard DNS lookup

function display_usage {
    echo "Usage: dns <fragment>"
    exit 1
}

##############################################################################
# Main routine
##############################################################################

if [ "$1" = "" ]
then
    display_usage
fi

case $1 in
    help)
        display_usage
        ;;
    manual)
        man dns-search
        ;;
esac

frag = shift
grep $frag /var/lib/powerdns/zones.master.d/*

exit

DOCS=<<__END_OF_DOCS__

=head1 NAME

dns-search - A simple wrapper for searching the DNS for a host

=head1 SYNOPSIS

dns-search [<host fragment>|help|manual]

=head1 DESCRIPTION

This script is a simple wrapper around grep to search the PowerDNS
database for a host.  It is intended to be a remctl target.

=head1 ACTIONS

=over 4

=item <host fragment>

The host name fragment to search for.

=item help

Display script usage.  This is the default action if not other action
is given on the command line.

=item manual

Display the man page for this script.

=back

=head1 AUTHOR

Bill MacAllister <bill@ca-zephyr.org>

=head1 COPYRIGHT

Copyright (C) 2026 Bill MacAllister <bill@ca-zephyr.org>

